# xerus-pod Development Environment
# Copy to .env: cp config/dev.env.example .env

# ── Provider Selection ───────────────────────────────────────────────────
POD_COMPUTE_PROVIDER=local-docker
POD_RUNTIME_PROVIDER=daytona
POD_IMAGE_NAME=xerus-sandbox

# ── Daytona Runtime ──────────────────────────────────────────────────────
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=dtn_CHANGE_ME_generate_with_openssl_rand_hex_32
DAYTONA_API_PORT=3000

# Daytona stack settings (used by docker-compose)
DB_USERNAME=user
DB_PASSWORD=pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RUNNER_CPU=4
RUNNER_MEMORY=8
RUNNER_DISK=50
RUNNER_API_KEY=secret_api_token
RUNNER_DOMAIN=runner
RESOURCE_LIMITS_DISABLED=true
PROXY_DOMAIN=proxy.127.0.0.1.sslip.io:4000
PROXY_PROTOCOL=http
PROXY_API_KEY=super_secret_key
SSH_HOST=localhost
SSH_GATEWAY_API_KEY=ssh_secret_api_token
PUBLIC_OIDC_DOMAIN=http://localhost:5556/dex
REGISTRY_PASSWORD=password

# ── SSH Keys (base64-encoded, auto-generated by Daytona setup) ────────
# Generate with: ssh-keygen -t rsa -b 3072 -f daytona_key -N "" && base64 -w0 daytona_key.pub && base64 -w0 daytona_key
SSH_PUBLIC_KEY_B64=CHANGE_ME
SSH_PRIVATE_KEY_B64=CHANGE_ME
SSH_HOST_KEY_B64=CHANGE_ME

# ── Telemetry ─────────────────────────────────────────────────────────
POSTHOG_API_KEY=CHANGE_ME

# ── MinIO S3 Storage ───────────────────────────────────────────────────
# The Daytona API uses http://minio:9000 (Docker-internal) for S3.
# When running SDK scripts on the host (e.g. npm run snapshot:create),
# the host cannot resolve "minio". This override rewrites the S3 URL
# to a host-reachable address. MinIO is port-forwarded to localhost:9000.
MINIO_ENDPOINT_OVERRIDE=http://localhost:9000

# ── Local Docker Compute (dev only) ─────────────────────────────────────
DOCKER_NETWORK=xerus-pod
