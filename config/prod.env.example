# xerus-pod Production Environment
# Copy and fill secrets: cp config/prod.env.example config/prod.env

# ── Provider Selection ───────────────────────────────────────────────────
POD_COMPUTE_PROVIDER=hetzner
POD_RUNTIME_PROVIDER=daytona
POD_IMAGE_NAME=xerus-sandbox

# ── Hetzner Compute ─────────────────────────────────────────────────────
HETZNER_API_TOKEN=CHANGE_ME
HETZNER_LOCATION=nbg1
HETZNER_SERVER_TYPE=cx32
HETZNER_IMAGE=ubuntu-24.04
HETZNER_SSH_KEY=xerus

# ── Daytona Runtime ──────────────────────────────────────────────────────
DAYTONA_API_URL=http://localhost:3000/api
DAYTONA_API_KEY=CHANGE_ME
DAYTONA_API_PORT=3000

# Daytona stack settings — CHANGE THESE
DB_USERNAME=daytona_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_ROOT_USER=xerus_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RUNNER_CPU=4
RUNNER_MEMORY=8
RUNNER_DISK=80
RUNNER_API_KEY=CHANGE_ME_STRONG_TOKEN
RUNNER_DOMAIN=YOUR_VPS_IP_OR_DOMAIN
RESOURCE_LIMITS_DISABLED=false
# Use your domain OR sslip.io (replace YOUR_VPS_IP): proxy.YOUR_VPS_IP.sslip.io:4000
PROXY_DOMAIN=proxy.YOUR_VPS_IP.sslip.io:4000
PROXY_PROTOCOL=https
PROXY_API_KEY=CHANGE_ME_STRONG_TOKEN
SSH_HOST=YOUR_VPS_IP_OR_DOMAIN
SSH_GATEWAY_API_KEY=CHANGE_ME_STRONG_TOKEN
PUBLIC_OIDC_DOMAIN=http://YOUR_VPS_IP:5556/dex
REGISTRY_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── MinIO S3 Storage ──────────────────────────────────────────────────
# The Daytona API uses http://minio:9000 (Docker-internal) for S3 push access.
# Scripts running on the host (npm run snapshot:create) need a host-reachable URL.
# On the VPS where backend and Docker run on the same machine, use localhost.
# Alternatively, add "127.0.0.1 minio" to /etc/hosts.
MINIO_ENDPOINT_OVERRIDE=http://localhost:9000
